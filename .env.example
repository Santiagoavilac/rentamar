# Supabase — Fase 1
# El proyecto remoto es cxozsfrwyvncdfulkcbi
NEXT_PUBLIC_SUPABASE_URL=https://cxozsfrwyvncdfulkcbi.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# SOLO server-side. Nunca exponer al navegador. Nunca prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Secreto para los endpoints internos dev de holds y pagos (dev/staging).
DEV_TASKS_SECRET=change-me

# Proveedor de pagos (Fase 2). Solo `mock` está soportado; default `mock`.
# No es sensible. Nunca prefijo NEXT_PUBLIC_ en variables sensibles.
PAYMENT_PROVIDER=mock

# Mapa interactivo — ruta de la imagen base para scripts/upload-map.mts.
# Opcional; por defecto ~/Downloads/Mapamaradentro.png. Se convierte a WebP con sips.
MAP_IMAGE_PATH=~/Downloads/Mapamaradentro.png

# Verificación de comprobantes con IA (Fase 2).
# SOLO server-side. Nunca exponer al navegador. Nunca prefijo NEXT_PUBLIC_.
OPENROUTER_API_KEY=your-openrouter-key
# Modelo multimodal para clasificar comprobantes. Cambiable sin tocar código.
# Default primario: qwen/qwen3-vl-8b-instruct. Si falla, se reintenta con el fallback.
OPENROUTER_PAYMENT_MODEL=qwen/qwen3-vl-8b-instruct
OPENROUTER_PAYMENT_MODEL_FALLBACK=qwen/qwen3-vl-32b-instruct
# Máximo de comprobantes que un cliente puede subir por pago. Default: 3.
RECEIPT_MAX_ATTEMPTS=3

# Datos bancarios globales que ve el cliente para transferir. No son secretos.
# La CUENTA RECEPTORA es la que la IA verifica en el comprobante: debe ser la real.
RECEIPT_BANK_HOLDER=Titular de la cuenta
RECEIPT_BANK_ACCOUNT=2504002171
RECEIPT_BANK_NAME=Banco
# Ruta pública del QR estático (en public/), ej. /templates/qr-pago.png. Opcional.
RECEIPT_BANK_QR_PATH=
